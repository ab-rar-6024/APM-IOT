# SMTP credentials used by app/api/contact/route.ts to send enquiry emails.
# Copy this file to .env.local and fill in real values — .env.local is never committed.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password

# Optional — defaults to SMTP_USER if omitted.
MAIL_FROM="APM Group <your-sending-address@gmail.com>"

# Where the "buy list" / enquiry notification is sent.
ADMIN_EMAIL=contact@apmiot.com
