# SMTP credentials used by app/api/contact/route.ts to send enquiry emails.
# Copy this file to .env.local and fill in real values — .env.local is never committed.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password

# Optional — defaults to SMTP_USER if omitted.
MAIL_FROM="APM Group <your-sending-address@gmail.com>"

# Where the "buy list" / enquiry notification is sent.
ADMIN_EMAIL=contact@apmiot.com

# --- Admin CMS (/admin) — blog & news post management ---------------------

# Supabase project credentials: Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only — never expose this to the browser. Used by /api/admin/** routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The password used to sign in at /admin/login.
ADMIN_PASSWORD=choose-a-strong-password

# Random string used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
